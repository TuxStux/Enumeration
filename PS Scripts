Write-Host "==============================================" -ForegroundColor Cyan
Write-Host ""

foreach ($Account in $Accounts) {

    Write-Host "==================================================" -ForegroundColor DarkGray
    Write-Host "[*] Account: $Account" -ForegroundColor Cyan

    try {

        # ----------------------------------------------------
        # QUERY ACCOUNT FROM AD
        # ----------------------------------------------------

        $User = Get-ADUser $Account `
            -Server $DC `
            -Properties Enabled,
                        ServicePrincipalName,
                        PasswordLastSet,
                        PasswordNeverExpires,
                        TrustedForDelegation,
                        TrustedToAuthForDelegation,
                        msDS-AllowedToDelegateTo `
            -ErrorAction Stop

        $SPNs = @($User.ServicePrincipalName)

        Write-Host ""
        Write-Host "Enabled              : $($User.Enabled)"
        Write-Host "PasswordLastSet      : $($User.PasswordLastSet)"
        Write-Host "PasswordNeverExpires : $($User.PasswordNeverExpires)"
        Write-Host "SPN Count            : $($SPNs.Count)"
        Write-Host "TrustedForDelegation : $($User.TrustedForDelegation)"
        Write-Host "ProtocolTransition   : $($User.TrustedToAuthForDelegation)"

        # ----------------------------------------------------
        # VALIDATE ACCOUNT
        # ----------------------------------------------------

        if (-not $User.Enabled) {

            Write-Host ""
            Write-Host "[-] Account is disabled." -ForegroundColor Red
            continue
        }

        if ($SPNs.Count -eq 0) {

            Write-Host ""
            Write-Host "[-] Account has no SPNs." -ForegroundColor Red
            continue
        }

        # ----------------------------------------------------
        # DISPLAY SPNs
        # ----------------------------------------------------

