# ADModule Queries for AD Enumeration


```
$server = "10.21.65.229"

$pattern = 'pass(word|wd)?|pwd|credential|secret|token|api.?key|login|user(name)?|temporary|temp.?pass'

Get-ADUser -Filter * -Server $server `
    -Properties Description,Info,Comment,Office,Homepage |
ForEach-Object {

    $u = $_

    @{
        Description = $u.Description
        Info        = $u.Info
        Comment     = $u.Comment
        Office      = $u.Office
        Homepage    = $u.Homepage
    }.GetEnumerator() | ForEach-Object {

        if($_.Value -and $_.Value -match $pattern) {
            [PSCustomObject]@{
                User      = $u.SamAccountName
                Attribute = $_.Key
                Value     = $_.Value
            }
        }
    }
} | Format-Table -Wrap -AutoSize
```

# Check computer desccriptions

```
Get-ADComputer -Filter * -Server 10.21.65.229 `
-Properties Description |
Where-Object {$_.Description} |
Select Name,Description |
Format-Table -Wrap -AutoSize
```

# Check Groups

```
Get-ADGroup -Filter * -Server 10.21.65.229 `
-Properties Description,Info |
Where-Object {$_.Description -or $_.Info} |
Select Name,Description,Info |
Format-Table -Wrap -AutoSize
```


# Mini NXC

```
$Subnet = "10.21.65"
$Timeout = 300

Write-Host "`n=== Native PowerShell SMB Mapper ===" -ForegroundColor Cyan
Write-Host "Target: $Subnet.0/24`n"

$Results = @()

1..254 | ForEach-Object {

    $IP = "$Subnet.$_"
    $Client = New-Object System.Net.Sockets.TcpClient

    try {
        $AR = $Client.BeginConnect($IP,445,$null,$null)

        if($AR.AsyncWaitHandle.WaitOne($Timeout,$false) -and $Client.Connected) {

            $Client.EndConnect($AR)

            Write-Host "[+] $IP :445 OPEN" -ForegroundColor Green

            # -----------------------------
            # DNS / hostname
            # -----------------------------
            $Hostname = $null

            try {
                $Hostname = ([System.Net.Dns]::GetHostEntry($IP)).HostName
            } catch {}

            # -----------------------------
            # Current-credential SMB access
            # -----------------------------
            $IPC = $false

            try {
                $p = Start-Process `
                    -FilePath "cmd.exe" `
                    -ArgumentList "/c dir \\$IP\IPC$ >nul 2>&1" `
                    -WindowStyle Hidden `
                    -Wait `
                    -PassThru

                if($p.ExitCode -eq 0) {
                    $IPC = $true
                }
            } catch {}

            # -----------------------------
            # SMB configuration
            # Works when remotely queryable
            # -----------------------------
            $SMB1 = "?"
            $SMB2 = "?"
            $SigningRequired = "?"

            try {
                $Session = New-CimSession `
                    -ComputerName $IP `
                    -OperationTimeoutSec 2 `
                    -ErrorAction Stop

                try {
                    $Cfg = Get-SmbServerConfiguration `
                        -CimSession $Session `
                        -ErrorAction Stop

                    $SMB1 = $Cfg.EnableSMB1Protocol
                    $SMB2 = $Cfg.EnableSMB2Protocol
                    $SigningRequired = $Cfg.RequireSecuritySignature
                } catch {}

                Remove-CimSession $Session -ErrorAction SilentlyContinue
            } catch {}

            $Object = [PSCustomObject]@{
                IP              = $IP
                Hostname        = $Hostname
                Port445         = "OPEN"
                CurrentCredIPC  = $IPC
                SMB1            = $SMB1
                SMB2            = $SMB2
                SigningRequired = $SigningRequired
            }

            $Results += $Object

            Write-Host "    Hostname : $Hostname"

            if($IPC) {
                Write-Host "    IPC$     : ACCESSIBLE with current credentials" -ForegroundColor Yellow
            } else {
                Write-Host "    IPC$     : no current-session access"
            }

            Write-Host "    SMB1     : $SMB1"
            Write-Host "    SMB2/3   : $SMB2"
            Write-Host "    Signing  : $SigningRequired"
            Write-Host ""
        }
    }
    catch {}

    finally {
        $Client.Close()
    }
}

Write-Host "`n=== SMB HOST SUMMARY ===" -ForegroundColor Cyan

$Results |
    Sort-Object IP |
    Format-Table IP,Hostname,CurrentCredIPC,SMB1,SMB2,SigningRequired -AutoSize
```
