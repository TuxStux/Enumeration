            Write-Host ""
            Write-Host "Ticket information:"
            Write-Host "  Service : $($Token.ServicePrincipalName)"
            Write-Host "  ValidTo : $($Token.ValidTo)"

        }
        catch {

            Write-Host "[-] TGS REQUEST FAILED" -ForegroundColor Red
            Write-Host "    $($_.Exception.Message)"
            continue
        }

        # ----------------------------------------------------
        # DELEGATION TARGETS
        # ----------------------------------------------------

        Write-Host ""
        Write-Host "Delegation configuration:" -ForegroundColor Cyan

        if ($User.'msDS-AllowedToDelegateTo') {

            foreach ($Target in $User.'msDS-AllowedToDelegateTo') {
                Write-Host "  $Target"
            }

        }
        else {

            Write-Host "  None"
        }

        # ----------------------------------------------------
        # RESULT
        # ----------------------------------------------------

        Write-Host ""
        Write-Host "RESULT:" -ForegroundColor Cyan

        Write-Host "  [+] Enabled user account"
        Write-Host "  [+] Registered SPN"
        Write-Host "  [+] Standard domain session obtained TGS" `
            -ForegroundColor Green

        if ($User.TrustedToAuthForDelegation) {

            Write-Host "  [+] Protocol-transition delegation configured" `
                -ForegroundColor Yellow
        }

        Write-Host ""
    }

    catch {

        Write-Host ""
        Write-Host "[-] AD QUERY FAILED" -ForegroundColor Red
        Write-Host "    $($_.Exception.Message)"
    }
}

