$h="10.21.65.X"

Write-Host "`n=== LDAPS ENUM: $h ===" -ForegroundColor Cyan

# ------------------------------------------------------------
# 1. TCP/636
# ------------------------------------------------------------
Write-Host "`n[+] Testing TCP/636..."

$tcp = New-Object Net.Sockets.TcpClient

try {
    $ar = $tcp.BeginConnect($h,636,$null,$null)

    if(-not $ar.AsyncWaitHandle.WaitOne(3000,$false)) {
        Write-Host "[-] TCP/636 TIMEOUT"
        $tcp.Close()
        return
    }

    $tcp.EndConnect($ar)

    if(-not $tcp.Connected) {
        Write-Host "[-] TCP/636 CLOSED"
        $tcp.Close()
        return
    }

    Write-Host "[+] TCP/636 OPEN" -ForegroundColor Green
}
catch {
    Write-Host "[-] TCP/636 FAILED: $($_.Exception.Message)"
    $tcp.Close()
    return
}

$tcp.Close()

# ------------------------------------------------------------
# 2. TLS / CERTIFICATE
# ------------------------------------------------------------
Write-Host "`n=== TLS CERTIFICATE ==="

$tcp = New-Object Net.Sockets.TcpClient

try {
    $tcp.Connect($h,636)

    $ssl = New-Object Net.Security.SslStream(
        $tcp.GetStream(),
        $false,
        ({$true})
    )

    $ssl.AuthenticateAsClient($h)

    $cert = New-Object Security.Cryptography.X509Certificates.X509Certificate2(
        $ssl.RemoteCertificate
    )

    Write-Host "[+] TLS handshake successful" -ForegroundColor Green

    $cert | Format-List `
        Subject,
        Issuer,
        DnsNameList,
        NotBefore,
        NotAfter,
        Thumbprint

    $ssl.Close()
    $tcp.Close()
}
catch {
    Write-Host "[-] TLS handshake failed: $($_.Exception.Message)"
    try {$tcp.Close()} catch {}
}

# ------------------------------------------------------------
# 3. LDAP ROOTDSE
# ------------------------------------------------------------
Write-Host "`n=== LDAP ROOTDSE ==="

try {
    Add-Type -AssemblyName System.DirectoryServices.Protocols

    $id = New-Object System.DirectoryServices.Protocols.LdapDirectoryIdentifier(
        $h,
        636
    )

    $ldap = New-Object System.DirectoryServices.Protocols.LdapConnection($id)

    $ldap.SessionOptions.SecureSocketLayer = $true
    $ldap.SessionOptions.VerifyServerCertificate = { param($conn,$cert) $true }

    $ldap.AuthType = [System.DirectoryServices.Protocols.AuthType]::Anonymous
    $ldap.Timeout = New-TimeSpan -Seconds 5

    $req = New-Object System.DirectoryServices.Protocols.SearchRequest(
        "",
        "(objectClass=*)",
        [System.DirectoryServices.Protocols.SearchScope]::Base,
        @("*","+")
    )

    $res = $ldap.SendRequest($req)

    if($res.Entries.Count -gt 0) {

        Write-Host "[+] Anonymous RootDSE query successful" -ForegroundColor Green

        $entry = $res.Entries[0]

        $interesting = @(
            "dnsHostName",
            "defaultNamingContext",
            "rootDomainNamingContext",
            "configurationNamingContext",
            "schemaNamingContext",
            "namingContexts",
            "supportedLDAPVersion",
            "supportedSASLMechanisms",
            "supportedCapabilities"
        )

        foreach($name in $interesting) {

            if($entry.Attributes.Contains($name)) {

                $values = $entry.Attributes[$name].GetValues([string])

                foreach($value in $values) {
                    Write-Host ("{0,-30} : {1}" -f $name,$value)
                }
            }
        }

        Write-Host "`n=== ALL ROOTDSE ATTRIBUTES ==="

        foreach($name in $entry.Attributes.AttributeNames) {

            $values = $entry.Attributes[$name].GetValues([string])

            Write-Host ("{0,-30} : {1}" -f $name,($values -join ", "))
        }
    }

    $ldap.Dispose()
}
catch {
    Write-Host "[-] RootDSE query failed: $($_.Exception.Message)"
}

Write-Host "`n=== DONE ===" -ForegroundColor Cyan
