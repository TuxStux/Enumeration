Write-Host "==================================================" -ForegroundColor Cyan

$Results |
Where-Object {$_.TGSRequest -eq "SUCCESS"} |
Select-Object Account,SelectedSPN,ValidFrom,ValidTo,ProtocolTransition,DelegationTargetCount |
Format-Table -Wrap -AutoSize

