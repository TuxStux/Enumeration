Import-Module ActiveDirectory

Write-Host "`n=== SPN / KERBEROS TGS ENUMERATION ===" -ForegroundColor Cyan
Write-Host "AD Server : $DC"
Write-Host "User      : $env:USERDOMAIN\$env:USERNAME`n"

$Accounts=@(
    Get-ADUser -Filter 'ServicePrincipalName -like "*"' -Server $DC `
