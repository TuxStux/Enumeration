$Subnet = "10.21.49"

$Ports = @(21,23,80,135,139,445,1433,3389,5985,5986)

Write-Host "`n=== SERVICE TRIAGE: $Subnet.0/24 ===" -ForegroundColor Cyan

function Test-Port {
    param($IP,$Port,$Timeout=350)

    $c = New-Object Net.Sockets.TcpClient

    try {
        $ar=$c.BeginConnect($IP,$Port,$null,$null)

        if($ar.AsyncWaitHandle.WaitOne($Timeout,$false) -and $c.Connected){
            $c.EndConnect($ar)
            $c.Close()
            return $true
        }
    } catch {}

    try{$c.Close()}catch{}
    return $false
}

1..254 | ForEach-Object {

    $IP="$Subnet.$_"

    $Open=@()

    foreach($Port in $Ports){
        if(Test-Port $IP $Port){
            $Open += $Port
        }
    }

    if($Open.Count -eq 0){
        return
    }

    Write-Host "`n==============================================" -ForegroundColor DarkGray
    Write-Host "[+] $IP" -ForegroundColor Green
    Write-Host "    OPEN: $($Open -join ', ')"

    # ========================================================
    # FTP / 21
    # Banner only
    # ========================================================

    if($Open -contains 21){

        Write-Host "`n[FTP/21]" -ForegroundColor Cyan

        try{
            $tcp=New-Object Net.Sockets.TcpClient
            $tcp.Connect($IP,21)

            $stream=$tcp.GetStream()
            $stream.ReadTimeout=1500

            $reader=New-Object IO.StreamReader($stream)

            $banner=$reader.ReadLine()

            Write-Host "  Banner: $banner"

            $reader.Close()
            $tcp.Close()
        }
        catch{
            Write-Host "  Banner unavailable"
        }
    }

    # ========================================================
    # TELNET / 23
    # Banner only
    # ========================================================

    if($Open -contains 23){

        Write-Host "`n[TELNET/23]" -ForegroundColor Cyan

        try{
            $tcp=New-Object Net.Sockets.TcpClient
            $tcp.Connect($IP,23)

            $stream=$tcp.GetStream()
            $stream.ReadTimeout=1200

            Start-Sleep -Milliseconds 250

            $buffer=New-Object byte[] 1024
            $n=$stream.Read($buffer,0,$buffer.Length)

            if($n -gt 0){
                $banner=[Text.Encoding]::ASCII.GetString($buffer,0,$n)
                Write-Host "  Banner: $banner"
            }

            $tcp.Close()
        }
        catch{
            Write-Host "  No readable banner"
        }
    }

    # ========================================================
    # HTTP / 80
    # ========================================================

    if($Open -contains 80){

        Write-Host "`n[HTTP/80]" -ForegroundColor Cyan

        try{
            $r=Invoke-WebRequest `
                -Uri "http://$IP/" `
                -Method Head `
                -UseBasicParsing `
                -TimeoutSec 3

            Write-Host "  Status : $($r.StatusCode)"

            if($r.Headers["Server"]){
                Write-Host "  Server : $($r.Headers["Server"])" -ForegroundColor Yellow
            }

            if($r.Headers["WWW-Authenticate"]){
                Write-Host "  Auth   : $($r.Headers["WWW-Authenticate"])"
            }

            if($r.Headers["Allow"]){
                Write-Host "  Allow  : $($r.Headers["Allow"])"
            }
        }
        catch{
            Write-Host "  HTTP response: $($_.Exception.Message)"
        }
    }

    # ========================================================
    # SMB / 445
    # Current-session share enumeration
    # ========================================================

    if($Open -contains 445){

        Write-Host "`n[SMB/445]" -ForegroundColor Cyan

        $out=cmd.exe /c "net view \\$IP 2>&1"

        if($LASTEXITCODE -eq 0){

            Write-Host "  [+] Share enumeration SUCCESS" -ForegroundColor Green

            $out | ForEach-Object {
                Write-Host "      $_"
            }
        }
        else{
            Write-Host "  [-] Share enumeration denied/failed"
        }
    }

    # ========================================================
    # MSSQL / 1433
    # Current Windows identity only
    # ========================================================

    if($Open -contains 1433){

        Write-Host "`n[MSSQL/1433]" -ForegroundColor Cyan

        $cs="Server=$IP,1433;Database=master;Integrated Security=True;Connect Timeout=3"
        $sql=New-Object Data.SqlClient.SqlConnection($cs)

        try{
            $sql.Open()

            Write-Host "  [+] WINDOWS AUTH SUCCESS" -ForegroundColor Green

            $q=$sql.CreateCommand()
            $q.CommandText="SELECT SYSTEM_USER,USER_NAME(),@@VERSION"

            $r=$q.ExecuteReader()

            if($r.Read()){
                Write-Host "      Login   : $($r[0])"
                Write-Host "      DB User : $($r[1])"
                Write-Host "      Version : $($r[2])"
            }

            $r.Close()
        }
        catch{
            Write-Host "  [-] Windows auth rejected"
            Write-Host "      $($_.Exception.Message)"
        }
        finally{
            try{$sql.Close()}catch{}
        }
    }

    # ========================================================
    # RDP / 3389
    # ========================================================

    if($Open -contains 3389){

        Write-Host "`n[RDP/3389]" -ForegroundColor Cyan
        Write-Host "  [+] RDP listener reachable"

        try{
            $dns=[Net.Dns]::GetHostEntry($IP).HostName
            Write-Host "  Host: $dns"
        }catch{}
    }

    # ========================================================
    # WINRM HTTP / 5985
    # ========================================================

    if($Open -contains 5985){

        Write-Host "`n[WINRM/5985]" -ForegroundColor Cyan

        try{
            $r=Invoke-WebRequest `
                -Uri "http://$IP`:5985/wsman" `
                -UseBasicParsing `
                -TimeoutSec 3 `
                -ErrorAction Stop

            Write-Host "  Status: $($r.StatusCode)"
        }
        catch{
            if($_.Exception.Response){
                Write-Host "  [+] WSMan HTTP endpoint responded" -ForegroundColor Green

                $auth=$_.Exception.Response.Headers["WWW-Authenticate"]

                if($auth){
                    Write-Host "  Auth: $auth"
                }
            }
            else{
                Write-Host "  Response: $($_.Exception.Message)"
            }
        }
    }

    # ========================================================
    # WINRM HTTPS / 5986
    # ========================================================

    if($Open -contains 5986){

        Write-Host "`n[WINRM/5986]" -ForegroundColor Cyan
        Write-Host "  [+] WinRM HTTPS listener reachable"

        # Certificate information
        try{
            $tcp=New-Object Net.Sockets.TcpClient($IP,5986)

            $ssl=New-Object Net.Security.SslStream(
                $tcp.GetStream(),
                $false,
                ({$true})
            )

            $ssl.AuthenticateAsClient($IP)

            $cert=New-Object `
                Security.Cryptography.X509Certificates.X509Certificate2(
                    $ssl.RemoteCertificate
                )

            Write-Host "  Cert Subject: $($cert.Subject)"
            Write-Host "  Cert Issuer : $($cert.Issuer)"
            Write-Host "  Expires     : $($cert.NotAfter)"

            $ssl.Close()
            $tcp.Close()
        }
        catch{
            Write-Host "  Certificate unavailable"
        }
    }
}

Write-Host "`n=== COMPLETE ===" -ForegroundColor Cyan
