if ($TimeStamp) { TimeElapsed }
Write-Host -ForegroundColor Blue "=========|| Group Policy Password Check"

$GroupPolicy = @("Groups.xml", "Services.xml", "Scheduledtasks.xml", "DataSources.xml", "Printers.xml", "Drives.xml")
if (Test-Path "$env:SystemDrive\Microsoft\Group Policy\history") {
  Get-ChildItem -Recurse -Force "$env:SystemDrive\Microsoft\Group Policy\history" -Include @GroupPolicy
}

if (Test-Path "$env:SystemDrive\Documents and Settings\All Users\Application Data\Microsoft\Group Policy\history" ) {
  Get-ChildItem -Recurse -Force "$env:SystemDrive\Documents and Settings\All Users\Application Data\Microsoft\Group Policy\history"
}

Write-Host ""
if ($TimeStamp) { TimeElapsed }
Write-Host -ForegroundColor Blue "=========|| Recycle Bin TIP:"
Write-Host "If credentials are found in the recycle bin, tool from nirsoft may assist: http://www.nirsoft.net/password_recovery_tools.html" -ForegroundColor Yellow

######################## File/Folder Check ########################

Write-Host ""
if ($TimeStamp) { TimeElapsed }
Write-Host -ForegroundColor Blue "=========||  Password Check in Files/Folders"

# Looking through the entire computer for passwords
# Also looks for McAfee site list while looping through the drives.
if ($TimeStamp) { TimeElapsed }
Write-Host -ForegroundColor Blue "=========|| Password Check. Starting at root of each drive. This will take some time. Like, grab a coffee or tea kinda time."
Write-Host -ForegroundColor Blue "=========|| Looking through each drive, searching for $fileExtensions"
# Check if the Excel com object is installed, if so, look through files, if not, just notate if a file has "user" or "password in name"
try { 
  New-Object -ComObject Excel.Application | Out-Null
  $ReadExcel = $true 
}
catch {
  $ReadExcel = $false
  if($Excel) {
    Write-Host -ForegroundColor Yellow "Host does not have Excel COM object, will still point out excel files when found."  
  }
}
# Compile the pattern table once for the whole drive walk, and cap how many matches print.
$FileHitCap = 5
$script:FileRegexes = @()
foreach ($n in $regexSearch.Keys) {
  try {
    $script:FileRegexes += [PSCustomObject]@{
      Name  = $n
      Regex = [regex]::new($regexSearch[$n], [System.Text.RegularExpressions.RegexOptions]'Compiled,IgnoreCase')
    }
  }
  catch { }   # skip a pattern .NET will not compile
}

$Drives.Root | ForEach-Object {
  $Drive = $_
  Get-ChildItem $Drive -Recurse -Include ($fileExtensions + $script:CredentialFileNames) -ErrorAction SilentlyContinue -Force | ForEach-Object {
    $path = $_
    # Skip known-noisy directories -- see $script:ExcludedDirectories to tune.
    if ($script:ExcludedDirectories.Where({ $Path.FullName.IndexOf($_, [System.StringComparison]::OrdinalIgnoreCase) -ge 0 }, 'First')) {
      return
    }
    if($Path.FullName | Select-String "(?i).:\\.*\\.*Pass.*"){
      write-host -ForegroundColor Blue "$($path.FullName) contains the word 'pass'"
    }
    if($FullCheck -and $Path.FullName | Select-String ".:\\.*\\.*user.*" ){
      Write-Host -ForegroundColor Blue "$($path.FullName) contains the word 'user' -excluding the 'users' directory"
    }

    # A credential-bearing filename is itself the finding.
    foreach ($cn in $script:CredentialFileNames) {
      if ($path.Name -like $cn) {
        Write-Host -ForegroundColor Cyan "$($path.FullName) - Credential file found"
        break
      }
    }

    # If path name ends with common excel extensions
    if ($Path.FullName | Select-String ".*\.xls",".*\.xlsm",".*\.xlsx") {
      if ($ReadExcel -and $Excel) {
        Search-Excel -Source $Path.FullName -SearchText "user"
        Search-Excel -Source $Path.FullName -SearchText "pass"
      }
    }
    elseif ($script:BinaryCredentialFiles -notcontains $path.Extension.ToLower()) {
      if ($path.Length -gt 0) {
        # Write-Host -ForegroundColor Blue "Path name matches extension search: $path"
      }
      if ($path.FullName | Select-String "(?i).*SiteList\.xml") {
        Write-Host "Possible McAfee Site List Found: $($_.FullName)"
        Write-Host "Just going to leave this here: https://github.com/funoverip/mcafee-sitelist-pwd-decryption" -ForegroundColor Yellow
      }
      # Read the file ONCE and test every pattern per line.
      $hits = @{}
      # Small text file outside vendor/system dirs: also look for a bare secret,
      $noteScan = ($path.Length -le 4096 -and $path.FullName -inotmatch $script:SecretNoteColdPath)
      $noteLines = 0
      $noteFound = New-Object System.Collections.ArrayList
      try {
        foreach ($line in [System.IO.File]::ReadLines($path.FullName)) {
          if ($noteScan -and $line.Trim() -and $line -inotmatch 'https?://') {
            $noteLines++
            # Split on assignment delimiters too, 'Version=4.0.0.0' then fails the test.
            foreach ($tok in ($line -split '[\s,;|=:]+')) {
              $tok = $tok.Trim()
              if ($tok -and (Test-LooksLikeSecret $tok)) {
                $ctx = $line.Trim()
                if ($ctx.Length -gt 120) { $ctx = $ctx.Substring(0, 120) + '...' }
                [void]$noteFound.Add([PSCustomObject]@{ Token = $tok; Line = $ctx })
              }
            }
          }
          if ($line.Length -gt 4000) { continue } # Minified or single-line blobs: matching them says nothing useful
          foreach ($rx in $script:FileRegexes) {
            if ([int]$hits[$rx.Name] -ge $FileHitCap) { continue }
            if (-not $rx.Regex.IsMatch($line)) { continue }
            if (-not $hits.ContainsKey($rx.Name)) {
              Write-Host "Possible Password found: $($rx.Name)" -ForegroundColor Yellow
              Write-Host $Path.FullName
            }
            $hits[$rx.Name] = 1 + [int]$hits[$rx.Name]
            $t = $line.Trim()
            if ($t.Length -gt 240) { $t = $t.Substring(0, 240) + '...(truncated)' }
            Write-Host "    $t" -ForegroundColor Red
            if ([int]$hits[$rx.Name] -eq $FileHitCap) {
              Write-Host "    ...further $($rx.Name) matches in this file suppressed" -ForegroundColor DarkGray
            }
          }
        }
        # Sparse files only: a note is a handful of lines, not a document.
        if ($noteScan -and $noteFound.Count -and $noteLines -le 40) {
          $seg = $path.FullName -split '\\'
          $tree = ($seg[0..([Math]::Min(2, $seg.Count - 1))] -join '\')
          foreach ($n in $noteFound) {
            [void]$script:SecretNoteCandidates.Add([PSCustomObject]@{
                File = $path.FullName; Tree = $tree; Token = $n.Token; Line = $n.Line
              })
          }
        }
      }
      catch { }   # locked, in use, or not readable as text
    }
  }
}

Write-Host ""
if ($TimeStamp) { TimeElapsed }
Write-Host -ForegroundColor Blue "=========|| Bare secrets in note files (no keyword nearby)"
Show-SecretNoteCandidates

######################## Registry Password Check ########################

Write-Host -ForegroundColor Blue "=========|| Registry Password Check"

@{ 'HKLM' = [Microsoft.Win32.Registry]::LocalMachine
  'HKCU'  = [Microsoft.Win32.Registry]::CurrentUser
}.GetEnumerator() | ForEach-Object {
  Search-RegistrySecrets -Hive $_.Value -Label $_.Key -Patterns $regexSearch -IncludeGeneric:$FullCheck
  if ($TimeStamp) { TimeElapsed }
  Write-Host "Finished $($_.Key)"
}

Save-WinAPESReport
