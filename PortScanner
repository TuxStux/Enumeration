$subnet = "192.168.1"
$ports = 21,22,23,25,53,80,88,110,135,139,143,389,443,445,464,502,515,636,1433,1521,1883,2049,3306,3389,5432,5900,5985,5986,8080,8443,8883,9389

1..254 | ForEach-Object {
    $ip = "$subnet.$_"

    foreach ($port in $ports) {
        $client = New-Object System.Net.Sockets.TcpClient

        try {
            $result = $client.BeginConnect($ip,$port,$null,$null)

            if ($result.AsyncWaitHandle.WaitOne(250,$false)) {
                try {
                    $client.EndConnect($result)

                    if ($client.Connected) {
                        Write-Host "$ip`tTCP/$port`tOPEN"
                    }
                } catch {}
            }
        } catch {}

        $client.Close()
    }
}
